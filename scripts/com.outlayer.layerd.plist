<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.outlayer.layerd</string>
    <key>ProgramArguments</key>
    <array>
        <!-- UPDATE: path to your layerd binary -->
        <string>/Users/YOU/.inlayer/bin/layerd</string>
        <string>--foreground</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <!-- UPDATE: path to your log file -->
    <string>/Users/YOU/.inlayer/layerd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/.inlayer/layerd.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/YOU/.inlayer</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <!-- UPDATE: your home directory -->
        <string>/Users/YOU</string>
        <key>PATH</key>
        <!-- UPDATE: include directory with inlayer binary -->
        <string>/Users/YOU/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
