<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.outlayer.layerd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/layerd</string>
        <string>--foreground</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/layerd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/layerd.log</string>
    <key>WorkingDirectory</key>
    <string>/usr/local/var/layerd</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/newsetup</string>
    </dict>
</dict>
</plist>
